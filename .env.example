# Google Gemini API Configuration (Server-Side Only - Never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# NexSpace Python ML Backend (Optional - defaults to http://localhost:8000)
ML_BACKEND_URL=http://localhost:8000

# Next.js Web Server Port (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Google Maps Platform Integration (Section 14, 22, 23)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Public client-side API key for Google Maps JS API.
# Required for interactive map display, satellite tiles, detection pins, and polygons.
# Note: Google Maps Platform requires billing enabled and appropriate API restrictions.
# Do NOT scrape Google satellite tiles for model training or benchmark ground truth.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Google Geocoding API key (Optional: OpenStreetMap Nominatim used as default)
# GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Satellite Earth-Observation Providers (Copernicus / STAC)
# ------------------------------------------------------------------------------
# Default provider: Element84 AWS Open STAC (Sentinel-2 L2A) - No API key required.
# Optional direct Copernicus Data Space Ecosystem (CDSE) credentials:
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# NexSpace Conversational AI Assistant (V2)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Server-side OpenAI API key (Responses / Chat completions API).
# NEVER set this as NEXT_PUBLIC_* — it must remain strictly server-side.
OPENAI_API_KEY=

# Optional alternative provider: Server-side Anthropic API key
ANTHROPIC_API_KEY=

# Optional: LLM model override for the conversational assistant.
# Default for OpenAI: gpt-4o-mini | Default for Anthropic: claude-3-5-haiku-20241022
NEXSPACE_ASSISTANT_MODEL=gpt-4o-mini

# Optional: Relational Database (Prisma defaults to resilient in-memory mock if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexspace
