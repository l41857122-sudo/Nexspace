# ==============================================================================
# NexSpace Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development.
# ==============================================================================

# ML Backend Service URL (Python FastAPI microservice)
ML_BACKEND_URL=http://localhost:8000

# Next.js Web Server Port (Default: 3000)
PORT=3000

# Optional: External LLM & Agent Keys (Leave blank for local offline mode)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: Relational Database (Prisma defaults to resilient in-memory mock if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexspace
