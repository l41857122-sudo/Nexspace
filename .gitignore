# ==============================================================================
# NexSpace Git Ignore Configuration
# ==============================================================================

# Node dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts
.vercel

# Environment Files & Secrets (Keep .env.example tracked, ignore all real envs)
.env*
!.env.example

# Python Environments & Caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.coverage
/coverage

# Logs & Diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
ml_backend/scratch_test_blip_quality.py
scratch/

# OS & Miscellaneous
.DS_Store
Thumbs.db
*.pem
